{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The APIs the oldest supported browsers (Chrome 61, Firefox 60, Safari 11) have; Vite only rewrites syntax
    "lib": ["ES2017", "DOM"],
    "types": ["vite/client"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts"]
}
