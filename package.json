{
  "name": "subnet-calculator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "./scripts/build.sh",
    "pretest": "python3 scripts/gen_cases.py",
    "test": "vitest run",
    "coverage": "npm test -- --coverage --coverage.reporter=text --coverage.reporter=lcovonly",
    "lint": "biome check",
    "format": "biome check --write",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "classic-stylesheets": "^2.1.3"
  }
}
