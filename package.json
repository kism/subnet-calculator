{
  "name": "subnet-calculator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "./scripts/build.sh",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tests",
    "pretest": "python3 scripts/gen_cases.py",
    "test": "vitest run",
    "coverage": "pnpm test --coverage --coverage.reporter=text --coverage.reporter=lcovonly",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "classic-stylesheets": "^2.1.3"
  }
}
