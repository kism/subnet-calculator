{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "subnet-calculator",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist"
  },
  "routes": [{ "pattern": "network.autist.network", "custom_domain": true }],
  // Per-version preview links (<version>-subnet-calculator.<subdomain>.workers.dev) for non-production
  // branches. Wrangler leaves them unset when routes exist, so turn them on; the bare workers.dev URL stays off.
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview`; empty because there are no bindings to override
  "previews": {}
}
